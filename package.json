{
  "name": "socrata-meta-chicago",
  "private": false,
  "type": "module",
  "scripts": {
    "fetch:catalogs": "node scripts/fetch-catalogs.mjs",
    "fetch:metadata": "node --env-file-if-exists=.env scripts/fetch-metadata.mjs",
    "fetch:metadata:oldest": "node --env-file-if-exists=.env scripts/fetch-metadata.mjs --oldest 50",
    "fetch:metadata:discover": "node --env-file-if-exists=.env scripts/fetch-metadata.mjs --discover",
    "build": "node scripts/build.mjs",
    "discover": "npm run fetch:catalogs && npm run fetch:metadata:discover",
    "refresh": "npm run fetch:catalogs && npm run fetch:metadata && npm run build",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=22.9"
  }
}
